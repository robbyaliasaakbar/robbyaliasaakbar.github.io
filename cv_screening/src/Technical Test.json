    {
      "parameters": {
        "jsCode": "const first=$input.first().json; const body=first.body??first; let arr=Array.isArray(body)?body:(Array.isArray(body.data)?body.data:(body.body&&Array.isArray(body.body)?body.body:[body])); arr=arr.filter(o=>o&&typeof o==='object').slice(0,5); return arr.map((item,idx)=>{ const text=(item.text||item.isi_cv||'').toString(); const filename=item.filename||item.nama_file_cv||`CV_${idx+1}.pdf`; let nama=filename.replace(/\\.pdf$/i,''); if(text){const fl=text.split('\\n').map(s=>s.trim()).find(s=>s.length>3&&s.length<60); if(fl) nama=fl.slice(0,60);} return {json:{id_cv:item.id||item.id_cv||`cv_${idx+1}`,nama_file_cv:filename,nama_pengirim:nama,isi_cv:text,size_kb:item.size_kb||0,page_count:item.page_count||0,uploaded_at:item.uploaded_at||new Date().toISOString(),raw:item}};});"
      },
      "id": "45d726d1-59fc-488b-ae29-2dc194b9c5da",
      "name": "Code Extractor",
      "type": "n8n-nodes-base.code",
