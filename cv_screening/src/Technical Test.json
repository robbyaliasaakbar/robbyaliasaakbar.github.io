    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Hitung 1 CV per 1 - 6 field output\nconst j = $input.item.json;\nconst txt = (j.isi_cv || '').toLowerCase();\nlet posisi = j.posisi || 'Junior Architect';\nlet skills = [];\nif (posisi === 'Junior Architect' || posisi === 'Posisi A') skills = ['autocad','revit','sketchup','lumion','building code','project management','site supervisor','design','planning','architect'];\nelse if (posisi === 'Drafter & 3D Visualization' || posisi === 'Posisi B') skills = ['autocad','sketchup','enscape','d5 render','vray','drafting','technical drawing','shop drawing','as built','drafter','lumion'];\nelse if (posisi === 'Interior Designer' || posisi === 'Posisi C') skills = ['interior','furniture','lighting','rendering','photoshop','illustrator','v-ray','twinmotion','lumion','enscape'];\nelse skills = ['autocad','revit','sketchup','lumion'];\nlet keahlianList = [...new Set(skills.filter(s => txt.includes(s)))];\nif (j.keyword_match) keahlianList = [...new Set([...keahlianList, ...j.keyword_match])];\nconst keahlianCount = Math.min(keahlianList.length, 10);\nconst skillScore = (keahlianCount / 10) * 50;\nconst eduKeywords = ['s1 arsitektur','sarjana arsitektur','bachelor of architecture','smk','smkn','master','magister','universitas','institute of technology'];\nlet edukasiList = eduKeywords.filter(k => txt.includes(k));\nif (edukasiList.length === 0 && txt.includes('pendidikan')) edukasiList = ['pendidikan'];\nconst edukasiCount = Math.min(edukasiList.length, 4);\nconst eduScore = (edukasiCount / 4) * 20;\nlet expTahun = 0;\nconst expMatches = txt.match(/(\\d+)\\s*(tahun|year)/g);\nif (expMatches) expMatches.forEach(m=>{ const n=parseInt(m); if(!isNaN(n)) expTahun=Math.max(expTahun,n); });\nif (expTahun===0 && txt.includes('10 years')) expTahun=10;\nif (expTahun===0 && txt.includes('5 tahun')) expTahun=5;\nconst expCount=Math.min(expTahun,6);\nconst expScore=(expCount/6)*30;\nconst total=Math.round(skillScore+eduScore+expScore);\nconst status=total>=65?'Lolos':'Tidak Lolos';\nconst alasan=status==='Lolos'?`Lolos ${total}% utk ${posisi}`:`Tidak Lolos ${total}% utk ${posisi}`;\nreturn { json: { id_cv: j.id_cv, nama_file: j.nama_file || j.nama_file_cv, total_score: total, posisi, status, alasan } };\n"
      },
