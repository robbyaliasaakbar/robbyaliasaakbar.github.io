    {
      "parameters": {
        "jsCode": "const posA=['architect','architecture','s1 arsitektur','junior architect','autocad','revit','sketchup','lumion','building code','project management','site supervisor','design','planning']; const posB=['drafter','3d visualization','3d visualisation','enscape','d5 render','shop drawing','as built','as-built','vray','drafting','technical drawing','quality control','autocad','sketchup','lumion']; const posC=['interior','interior designer','interior architect','furniture','lighting','rendering','photoshop','illustrator','v-ray','twinmotion']; return $input.all().map(item=>{ const j=item.json; const txt=(j.isi_cv||'').toLowerCase(); const count=arr=>arr.filter(k=>txt.includes(k)).length; const a=count(posA), b=count(posB), c=count(posC); let posisi='Posisi A'; let max=a; let keyword_match=posA.filter(k=>txt.includes(k)); if(b>max){max=b; posisi='Posisi B'; keyword_match=posB.filter(k=>txt.includes(k));} if(c>max){max=c; posisi='Posisi C'; keyword_match=posC.filter(k=>txt.includes(k));} if(a===b && a===c && a>0) {posisi='Posisi A'; keyword_match=posA.filter(k=>txt.includes(k)); max=a;} return {json:{...j,posisi,keyword_match,keyword_score:max,keyword_detail:{posA:a,posB:b,posC:c}}};});"
      },
