    {
      "parameters": {
        "jsCode": "// Ranking gabungan 5 CV - sort desc total_score\nconst all = $input.all().map(i => i.json);\n\nall.sort((a, b) => (b.total_score || 0) - (a.total_score || 0));\n\nconst ranking = all.map((c, idx) => ({\n  rank: idx + 1,\n  ...c\n}));\n\nreturn ranking.map(c => ({\n  json: c\n}));"
      },
